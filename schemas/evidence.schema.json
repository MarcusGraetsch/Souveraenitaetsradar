{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Souveraenitaetsradar Generic Evidence (legacy-compatible)",
  "description": "Cloud-agnostic generic evidence schema. New Evidence Packs should use evidence-record.schema.json.",
  "type": "object",
  "required": ["evidence_id", "source_type", "collected_at", "effective_trust", "applied_state"],
  "properties": {
    "evidence_id": {"type": "string"},
    "source_type": {"type": "string", "enum": ["external-document", "contract", "architecture", "iac-config", "provider-export", "test-result", "attestation", "manual-observation", "human-input", "public-provider", "project-assumption"]},
    "source_id": {"type": ["string", "null"]},
    "collected_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "object", "additionalProperties": true},
    "claim_ids": {"type": "array", "items": {"type": "string"}},
    "gate_ids": {"type": "array", "items": {"type": "string"}},
    "attachment_ref": {"type": ["string", "null"]},
    "locator": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"]},
    "base_trust": {"type": "integer", "minimum": 0, "maximum": 5},
    "scope_fit": {"type": "integer", "minimum": 0, "maximum": 5},
    "freshness_fit": {"type": "integer", "minimum": 0, "maximum": 5},
    "effective_trust": {"type": "integer", "minimum": 0, "maximum": 5},
    "applied_state": {"type": "string", "enum": ["asserted", "available", "documented", "observed", "configured", "tested", "attested"]},
    "condition_status": {"type": "string", "enum": ["met", "not_met", "unknown"]},
    "review_status": {"type": "string", "enum": ["raw", "normalized", "reviewed", "approved", "rejected"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
