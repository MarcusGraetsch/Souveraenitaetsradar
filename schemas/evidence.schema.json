{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Sovereignty Radar Evidence",
  "type":"object",
  "required":["evidence_id","source_type","collected_at","effective_trust","applied_state"],
  "properties":{
    "evidence_id":{"type":"string"},
    "source_type":{"type":"string","enum":["external-document","contract","technical-config","test-result","attestation","human-input","project-assumption"]},
    "source_id":{"type":["string","null"]},
    "collected_at":{"type":"string","format":"date-time"},
    "account_id":{"type":["string","null"]},
    "region":{"type":["string","null"]},
    "resource_arn":{"type":["string","null"]},
    "claim_ids":{"type":"array","items":{"type":"string"}},
    "gate_ids":{"type":"array","items":{"type":"string"}},
    "sha256":{"type":["string","null"]},
    "base_trust":{"type":"integer","minimum":0,"maximum":5},
    "scope_fit":{"type":"integer","minimum":0,"maximum":5},
    "freshness_fit":{"type":"integer","minimum":0,"maximum":5},
    "effective_trust":{"type":"integer","minimum":0,"maximum":5},
    "applied_state":{"type":"string","enum":["unknown","available","selected","configured","tested","attested"]},
    "condition_status":{"type":"string","enum":["met","not_met","unknown"]},
    "review_status":{"type":"string","enum":["raw","normalized","reviewed","approved"]},
    "notes":{"type":["string","null"]}
  },
  "additionalProperties":true
}