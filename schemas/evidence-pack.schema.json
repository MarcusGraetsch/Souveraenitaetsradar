{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sovradar/evidence-pack.schema.json",
  "title": "Souveraenitaetsradar Customer Evidence Pack",
  "type": "object",
  "required": ["schema_version", "assessment_id", "created_at", "producer", "scope", "evidence_files", "redaction_statement"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "assessment_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "required": ["organization", "role"],
      "properties": {"organization": {"type": "string"}, "role": {"type": "string"}},
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": ["workload_id"],
      "properties": {
        "workload_id": {"type": "string"}, "environment": {"type": "string"},
        "providers": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "evidence_files": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^evidence/[^/]+\\.json$"}},
    "attachment_policy": {"type": "string"},
    "redaction_statement": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
